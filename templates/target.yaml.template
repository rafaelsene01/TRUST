# ============================================================
# TRUST — targets/{{REPO_SLUG}}.yaml
# Generated by /trust init or /trust target add
# ============================================================

target:
  id: "{{REPO_SLUG}}"
  name: "{{REPO_NAME}}"
  description: "{{REPO_DESCRIPTION}}"
  owner: "{{TEAM_CONTACT}}"
  remote_url: "{{GIT_REMOTE_URL}}"
  repo_path: "${{{ENV_VAR_NAME}}:-{{DEFAULT_PATH}}}"
  default_branch: "main"
  stack:
    languages: {{LANGUAGES}}
    frameworks: {{FRAMEWORKS}}
    databases: {{DATABASES}}

applied_agents:
  - id: "security"
    enabled: true
  - id: "contracts"
    enabled: true
  - id: "data"
    enabled: true
  - id: "performance"
    enabled: true
  - id: "conventions"
    enabled: true
  - id: "tests"
    enabled: true

# Uncomment and populate to override rules for this target
# rule_overrides:
#   - rule_id: "PERF-012"
#     enabled: false
#     reason: "No SLO requirements for this service"

path_filters:
  ignore:
    - "node_modules/**"
    - "dist/**"
    - "build/**"
    - "**/*.generated.*"
    - "vendor/**"
    - ".git/**"
  focus: []

traceability:
  jira:
    enabled: false
    project_keys: []
  spec_files:
    enabled: false
    base_path: "docs/specs"

output:
  comment_on_pr: false
  pr_platform: "github"
  comment_style: "summary_with_link"
  review_md_path: "${TRUST_REVIEW_OUTPUT:-~/Documents/trust-reviews}/{{REPO_SLUG}}/${BRANCH_SLUG}/REVIEW.md"

runs:
  retention_policy: "audit_failures_only"

health_checks:
  - "repo_path_exists"
  - "git_remote_matches"
  - "default_branch_exists"
  - "applied_agents_have_skill_files"
