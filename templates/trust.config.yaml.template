# ============================================================
# TRUST — trust.config.yaml
# Generated by /trust init pilot
# ============================================================
# This file is the contract for your team's review setup.
# Commit it. Review changes via PR.
# ============================================================

framework:
  name: "TRUST"
  full_name: "Trustable Reviews via Universal Skills & Tooling"
  tagline: "O review de IA em que dá pra confiar"
  version: "2.2.0"
  mode: "strict"                 # strict | warn — never change to warn in prod

profile:
  type: "pilot"
  team_name: "{{TEAM_NAME}}"
  contact: "{{SLACK_CHANNEL}}"

setup_repo:
  remote: "{{SETUP_REPO_REMOTE}}"

# ------------------------------------------------------------
# GROUNDING SOURCES
# ------------------------------------------------------------
# Add more sources here as your setup evolves.
# Supported adapters (MVP): filesystem
# Coming in v1.1: notion, http (Confluence)
# ------------------------------------------------------------
grounding:
  sources:
    - id: "in-setup"
      adapter: "filesystem"
      base_path: "./grounding"
      volatile: false

    # Uncomment to add your second brain:
    # - id: "second-brain"
    #   adapter: "filesystem"
    #   base_path: "${TRUST_SECONDBRAIN_PATH:-}"
    #   volatile: true
    #   optional: true

    # Uncomment when ready for Confluence (v1.1+):
    # - id: "corp-confluence"
    #   adapter: "http"
    #   base_url: "https://{{COMPANY}}.atlassian.net/wiki/spaces/{{SPACE}}"
    #   auth_env: "CONFLUENCE_TOKEN"
    #   volatile: true

  required:
    - source: "in-setup"
      path: "01-architecture.md"
      purpose: "System architecture and module boundaries"
    - source: "in-setup"
      path: "02-domain-glossary.md"
      purpose: "Ubiquitous language and entity names"
    - source: "in-setup"
      path: "03-api-contracts.md"
      purpose: "API contracts and versioning policy"
    - source: "in-setup"
      path: "04-data-model.md"
      purpose: "Database schema, indexes, invariants"
    - source: "in-setup"
      path: "05-conventions.md"
      purpose: "Coding conventions, naming, error handling"
    - source: "in-setup"
      path: "06-security-policy.md"
      purpose: "Security policy applicable to this project"
    - source: "in-setup"
      path: "07-adrs/"
      purpose: "Architecture Decision Records"

  dod:
    all_required_loaded: true
    min_total_bytes: 5000
    hash_manifest_generated: true

# ------------------------------------------------------------
# AGENTS
# ------------------------------------------------------------
agents:
  - id: "security"
    skill: "./skills/trust-security-review/SKILL.md"
    checklist: "./checklists/security.checklist.md"
    file_patterns: ["**/*"]
    enabled: true

  - id: "contracts"
    skill: "./skills/trust-contracts-review/SKILL.md"
    checklist: "./checklists/contracts.checklist.md"
    file_patterns:
      - "**/*controller*"
      - "**/*handler*"
      - "**/*router*"
      - "**/openapi*.{yaml,yml,json}"
      - "**/*.proto"
    enabled: true

  - id: "data"
    skill: "./skills/trust-data-review/SKILL.md"
    checklist: "./checklists/data.checklist.md"
    file_patterns:
      - "**/migrations/**"
      - "**/*.sql"
      - "**/models/**"
      - "**/entities/**"
      - "**/*repository*"
    enabled: true

  - id: "performance"
    skill: "./skills/trust-performance-review/SKILL.md"
    checklist: "./checklists/performance.checklist.md"
    file_patterns: ["**/*"]
    enabled: true

  - id: "conventions"
    skill: "./skills/trust-conventions-review/SKILL.md"
    checklist: "./checklists/conventions.checklist.md"
    file_patterns: ["**/*"]
    enabled: true

  - id: "tests"
    skill: "./skills/trust-tests-review/SKILL.md"
    checklist: "./checklists/tests.checklist.md"
    file_patterns: ["**/*"]
    enabled: true

  dod:
    files_in_domain_evaluated_pct: 100
    rules_evaluated_pct: 100
    every_finding_has_rule_id: true
    every_finding_has_rule_source: true
    every_finding_has_evidence_quote: true
    every_finding_has_confidence: true

# ------------------------------------------------------------
# SECOND PASS
# ------------------------------------------------------------
second_pass:
  enabled: true
  dod:
    hunks_unaccounted: 0

# ------------------------------------------------------------
# PRECISION GATE
# ------------------------------------------------------------
precision_gate:
  confidence_threshold: 0.80
  dod:
    every_finding_classified: true
    silenced_preserved: true

# ------------------------------------------------------------
# META-REVIEW
# ------------------------------------------------------------
meta_review:
  enabled: true
  validation_checks:
    - "file_exists_in_diff"
    - "line_exists_in_diff"
    - "evidence_quote_is_literal"
    - "rule_source_resolves"
  dod:
    every_finding_passes_all_checks: true

# ------------------------------------------------------------
# INTEGRATIONS
# Configuradas pelo /trust init — não edite manualmente a menos
# que saiba o que está fazendo.
#
# source: auto  → tenta MCP primeiro, cai para api se env vars existirem
# source: mcp   → usa MCP tools do Claude Code (sem token necessário)
# source: api   → usa REST client com env vars declaradas em auth
# source: disabled → integração ignorada
# ------------------------------------------------------------
integrations:
  jira:
    source: disabled          # auto | mcp | api | disabled
    base_url: ""              # ex: https://empresa.atlassian.net
    project_keys: []          # ex: ["PAY", "AUTH"]
    branch_pattern: "(?:feat|fix|chore|refactor)/(?P<ticket>[A-Z]+-\\d+)"
    auth:                     # relevante apenas se source: api
      user_env: "JIRA_USER"
      token_env: "JIRA_TOKEN"

  notion:
    source: disabled
    auth:
      token_env: "NOTION_TOKEN"

  confluence:
    source: disabled
    base_url: ""              # ex: https://empresa.atlassian.net/wiki
    auth:
      user_env: "CONFLUENCE_USER"
      token_env: "CONFLUENCE_TOKEN"

  github:
    source: disabled          # auto | mcp | gh-cli | disabled
    repo: ""                  # owner/repo — deixar vazio para auto-detectar pelo cwd
    branch_pattern: "(?:feat|fix|chore|refactor|docs|test)/(?P<issue>\\d+)"

# Quando github.source != disabled, defina traceability.enabled: true para
# ligar Issues ao rastreamento de findings.

# ------------------------------------------------------------
# TRACEABILITY
# Usa as integrações acima para ligar findings ao ticket de origem.
# ------------------------------------------------------------
traceability:
  enabled: false              # habilitado automaticamente se jira.source != disabled
  spec_files:
    pattern: "**/*.spec.md"

# ------------------------------------------------------------
# OUTPUT
# ------------------------------------------------------------
output:
  default_path: "${TRUST_REVIEW_OUTPUT:-~/Documents/trust-reviews}"
  comment_on_pr:
    default: false
    requires_gh_cli: true
  ai_never_approves_or_rejects: true
  dod:
    counters_cross_validate: true
    run_manifest_complete: true

# ------------------------------------------------------------
# RUNS
# ------------------------------------------------------------
runs:
  base_dir: "./runs"
  retention_policy: "audit_failures_only"
  on_success:
    keep_artifacts: false
    keep_review_md: true
  on_halt:
    keep_artifacts: true
    auto_commit: false
